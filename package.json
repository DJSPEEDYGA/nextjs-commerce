{
  "name": "ms-money-penny-store",
  "version": "1.0.0",
  "description": "Ms Money Penny - Life Imitates Art Inc. E-Commerce Store",
  "author": {
    "name": "DJSPEEDYGA - Life Imitates Art Inc.",
    "email": "djspeedyga@lifeimitatesart.org"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:all": "electron-builder --win --mac --linux --x64"
  },
  "build": {
    "appId": "com.lifeimitatesart.msmoneypenny",
    "productName": "Ms Money Penny Store",
    "copyright": "Copyright © 2024 Life Imitates Art Inc. Nonprofit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "category": "public.app-category.shopping",
      "icon": "build/icon.icns",
      "darkModeSupport": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "dmg": {
      "icon": "build/icon.icns",
      "title": "Ms Money Penny Store"
    },
    "portable": {
      "artifactName": "Ms-Money-Penny-Store-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}