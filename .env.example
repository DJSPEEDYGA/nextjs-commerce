# ============================================================
# SUPER GOAT ROYALTIES - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app runs in DEMO MODE when no API keys are configured.
# Add any provider key below to enable live AI features.
# ============================================================

# --- Server Configuration ---
NODE_ENV=development
PORT=3000

# --- AI Provider Keys (add any to enable live AI) ---

# NVIDIA NIM - GPU-optimized inference (https://build.nvidia.com)
NVIDIA_API_KEY=

# OpenRouter - 653+ models gateway (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Google Gemini - Free multimodal AI (https://ai.google.dev)
GOOGLE_AI_KEY=
# Alternative key name:
# GEMINI_API_KEY=

# Lightning AI - Optimized model APIs (https://lightning.ai)
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://api.lightning.ai/v1
LIGHTNING_WORKSPACE=

# Hugging Face - Open model hub (https://huggingface.co)
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co

# --- NVIDIA OpenShell (Sandboxed Agent Execution) ---
OPENSHELL_GATEWAY_URL=
OPENSHELL_MODEL=nvidia/nemotron-3-nano-30b-a3b
OPENSHELL_GPU=false
OPENSHELL_POLICY=openshell-policy.yaml
OPENSHELL_MAX_SANDBOXES=9
OPENSHELL_SANDBOX_TIMEOUT=3600

# --- Optional: Google AI Studio (legacy key name) ---
GOOGLE_AI_STUDIO_KEY=

# --- Optional: Database (Supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional: Music Platform APIs ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=