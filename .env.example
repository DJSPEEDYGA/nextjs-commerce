# ==========================================
# SUPER GOAT ROYALTIES v3.0 - Configuration
# ==========================================
# Copy this file to .env and fill in your keys
# The app works in DEMO MODE without any keys!

# ---- NVIDIA NIM (Primary AI Engine) ----
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1

# ---- Google AI Studio (Optional) ----
# Get your key at: https://aistudio.google.com
GOOGLE_AI_STUDIO_KEY=

# ---- OpenAI (Optional, for LangChain) ----
OPENAI_API_KEY=

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development

# ---- Database (Optional - Supabase) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Platform API Keys (Optional) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ---- Security ----
JWT_SECRET=your-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here