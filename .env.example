# ============================================
# SUPER GOAT Royalties v3.1.0 — Configuration
# ============================================
# All keys are optional — the app runs in full DEMO MODE without any keys.
# Configure providers as needed to enable live AI features.

# ==================== AI PROVIDERS ====================

# NVIDIA NIM — GPU-optimized inference microservices
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1

# OpenRouter — Unified gateway to 653+ AI models
# Access OpenAI, Anthropic, Google, Meta, DeepSeek, Qwen, Mistral, and more
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Lightning AI — Optimized model serving APIs
# Get your key at: https://lightning.ai
LIGHTNING_API_KEY=
LIGHTNING_BASE_URL=https://api.lightning.ai/v1
LIGHTNING_WORKSPACE=

# Hugging Face — Open-source model hub (1M+ models)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co

# Google AI Studio
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_STUDIO_KEY=

# ==================== NVIDIA OPENSHELL ====================
# Sandboxed runtime for autonomous AI agents
# Docs: https://docs.nvidia.com/openshell

# Gateway URL (local: https://127.0.0.1:8080, remote: https://hostname:8080)
OPENSHELL_GATEWAY_URL=

# Default inference model for sandboxes
OPENSHELL_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Enable GPU passthrough (requires NVIDIA drivers + Container Toolkit)
OPENSHELL_GPU=false

# Security policy file
OPENSHELL_POLICY=openshell-policy.yaml

# Max simultaneous sandboxes (one per agent)
OPENSHELL_MAX_SANDBOXES=9

# Sandbox timeout in seconds (default: 1 hour)
OPENSHELL_SANDBOX_TIMEOUT=3600

# ==================== SERVER ====================

PORT=3000
NODE_ENV=production

# ==================== GOOGLE DRIVE ====================
# Google Drive API for funnel channel and data export
# Get your API key at: https://console.cloud.google.com/apis/credentials
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=17RV_P-8vWxnX6cmkJI_WF4He2kbiUaVf