# ==========================================
# SUPER GOAT ROYALTIES - Environment Config
# v3.2.0 - Lightning AI + HuggingFace + NVIDIA
# ==========================================

# Server
PORT=3000
NODE_ENV=development

# ---- NVIDIA NIM ----
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1

# ---- Lightning AI ----
LIGHTNING_API_KEY=your_lightning_api_key_here
LIGHTNING_API_URL=https://api.lightning.ai/v1

# ---- HuggingFace ----
HF_TOKEN=your_huggingface_token_here

# ---- HF Inference Providers ----
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
NOVITA_API_KEY=your_novita_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here
COHERE_API_KEY=your_cohere_api_key_here
SCALEWAY_API_KEY=your_scaleway_api_key_here
HYPERBOLIC_API_KEY=your_hyperbolic_api_key_here
FAL_API_KEY=your_fal_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here
NSCALE_API_KEY=your_nscale_api_key_here

# ---- Local Runners (optional) ----
OLLAMA_URL=http://localhost:11434
VLLM_URL=http://localhost:8000

# ---- Google AI Studio ----
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# ---- Security ----
JWT_SECRET=your_jwt_secret_here
BCRYPT_ROUNDS=10