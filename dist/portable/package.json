{
  "name": "super-goat-royalties-app",
  "productName": "SUPER GOAT ROYALTIES APP",
  "description": "AI-Powered Music Royalty Management Platform - The Ultimate Tool for Artists",
  "version": "3.0.0",
  "author": {
    "name": "Harvey L Miller Jr / DJ Speedy",
    "email": "contact@goatroyaltyapp.org",
    "url": "https://www.goatroyaltyapp.org"
  },
  "homepage": "https://www.goatroyaltyapp.org",
  "license": "MIT",
  "copyright": "Copyright © 2024 HARVEY L MILLER JR. All Rights Reserved.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "nexe": "^4.0.0-rc.1",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "org.goatroyaltyapp.super-goat-royalties",
    "productName": "SUPER GOAT ROYALTIES APP",
    "copyright": "Copyright © 2024 HARVEY L MILLER JR. All Rights Reserved.",
    "directories": {
      "output": "dist",
      "buildResources": "assets",
      "app": "."
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!**/*.ts",
      "!dist/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!scripts/**/*",
      "!.git/**/*",
      "!.github/**/*",
      "!*.log",
      "!*.md",
      "!todo.md"
    ],
    "extraResources": [
      {
        "from": "local-data",
        "to": "local-data",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "lib",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "lib/**/*",
      "local-data/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "publisherName": "GOAT Royalty App Organization",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SUPER GOAT ROYALTIES",
      "include": "scripts/installer.nsh",
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "type": "distribution"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Audio;Music;Finance;Business",
      "maintainer": "Harvey L Miller Jr <contact@goatroyaltyapp.org>",
      "desktop": {
        "Name": "SUPER GOAT ROYALTIES",
        "Comment": "AI-Powered Music Royalty Management Platform",
        "Categories": "Audio;Music;Finance;Business",
        "Keywords": "music;royalty;ai;management;artist",
        "StartupNotify": "true",
        "Terminal": "false"
      },
      "executableName": "super-goat-royalties",
      "synopsis": "The Ultimate Music Royalty Management Platform",
      "description": "SUPER GOAT ROYALTIES APP is a comprehensive AI-powered platform for managing music royalties, featuring 242+ API endpoints, 6 AI engines, voice commands, and real-time analytics."
    },
    "deb": {
      "priority": "optional",
      "compression": "xz"
    },
    "appImage": {
      "systemIntegration": "request"
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.goatroyaltyapp.org"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DJSPEEDYGA/nextjs-commerce.git"
  },
  "bugs": {
    "url": "https://github.com/DJSPEEDYGA/nextjs-commerce/issues"
  },
  "keywords": [
    "music",
    "royalty",
    "ai",
    "management",
    "artist",
    "platform",
    "streaming",
    "analytics",
    "dashboard"
  ]
}