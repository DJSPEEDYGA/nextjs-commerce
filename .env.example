# ==========================================
# SUPER GOAT ROYALTIES v3.0 - Configuration
# ==========================================
# Copy this file to .env and fill in your keys
# The app works in DEMO MODE without any keys!
#
# PRODUCTION CHECKLIST:
#   1. Set NODE_ENV=production
#   2. Set NVIDIA_API_KEY (or another AI provider key)
#   3. Set JWT_SECRET and ENCRYPTION_KEY to strong random values
#   4. Set DEMO_MODE=false to use live AI responses
#   5. Set VERCEL_URL or BASE_URL for your deployment domain

# ---- Demo / Live Mode ----
# Set DEMO_MODE=false to force live AI calls even when API keys are present.
# Set DEMO_MODE=true  to force demo mode regardless of API key presence.
# Default: auto-detected (demo=true when NVIDIA_API_KEY is empty)
# Example: DEMO_MODE=false
DEMO_MODE=

# ---- NVIDIA NIM (Primary AI Engine) ----
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1

# ---- Google AI Studio (Optional) ----
# Get your key at: https://aistudio.google.com
GOOGLE_AI_STUDIO_KEY=

# ---- OpenAI (Optional, for LangChain) ----
OPENAI_API_KEY=

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development
# Set to your Vercel deployment URL or custom domain (no trailing slash)
VERCEL_URL=
BASE_URL=http://localhost:3000

# ---- Database (Optional - Supabase) ----
SUPABASE_URL=
SUPABASE_KEY=

# ---- Platform API Keys (Optional) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ---- Webhooks (Optional) ----
# Secret used to validate incoming webhook payloads
WEBHOOK_SECRET=

# ---- Security ----
# Use long random strings in production (e.g. openssl rand -hex 32)
JWT_SECRET=your-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here