# ============================================================
# Agent-007 — environment config
# Copy to  agent007.env  and edit, then:  source agent007.env
# ============================================================

# --- Core ---
export AGENT007_HOME="$HOME/Agent007Runtime"

# --- LLM backend (Ollama) ---
export OLLAMA_PROXY_TARGET="http://127.0.0.1:11434"
# Default model 007 chats with (must be pulled — see models/MODELS.md)
export AGENT007_MODEL="llama3"

# --- Stable Diffusion (Codex Draw) for art/render ---
export AGENT007_AUTO1111_URL="http://127.0.0.1:7860"

# --- Voice / studio audio ---
# 1 = Agent-007 may speak out loud. 0 = text only (kill switch).
export AGENT007_SPEECH_ENABLED=0
# macOS voice name (run: say -v '?'  to list).  e.g. Daniel, Lee, Tom
export AGENT007_VOICE="Daniel"
# Audio output device to route his voice to (run: say -a '?'  to list).
# Set this to your Universal Audio interface name to talk through the studio.
# Leave blank to use the system default output.
export AGENT007_AUDIO_DEVICE=""

# --- Ports (usually leave as-is) ---
# Agent-007 chat server: 3333   |   GOAT intel backend: 5500
