{
  "name": "super-goat-royalty-app",
  "version": "5.0.0",
  "description": "🐐 SUPER GOAT ROYALTY APP — ULTIMATE EDITION: 242 APIs, AI Suite, Music Studio, Dating, UE5, Security, Web3 & More",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:all": "electron-builder --win --mac --linux",
    "test": "jest"
  },
  "keywords": [
    "super-goat-royalties",
    "ai",
    "llm",
    "nvidia",
    "nemo",
    "langchain",
    "rag",
    "autonomous-agents",
    "creator-platform",
    "royalties",
    "nft",
    "blockchain",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "DJSPEEDYGA",
    "email": "djspeedyga@goatroyalties.com"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.1.3",
    "@langchain/community": "^0.0.54",
    "@langchain/core": "^0.1.62",
    "@langchain/openai": "^0.0.25",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.36",
    "mammoth": "^1.6.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "build": {
    "appId": "com.goatroyalties.superapp",
    "productName": "SUPER GOAT Royalties",
    "copyright": "Copyright © 2024 DJSPEEDYGA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "electron-main.js",
      "preload.js",
      "public/**/*",
      "lib/**/*",
      "local-data/**/*",
      "*.json",
      "node_modules/**/*",
      "package.json",
      "favicon.ico",
      ".env"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GOAT-Royalties-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GOAT-Royalties-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "GOAT-Royalties-${version}.${ext}",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "GOAT-Royalties-${version}.${ext}",
      "category": "Audio"
    }
  }
}
